generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

}

model User {
  id        String   @id // Clerk userId
  createdAt DateTime @default(now())
  chats     Chat[]
}

model Chat {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  personaId String
  title     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]

  @@index([userId, updatedAt])
}

model Message {
  id        String   @id @default(cuid())
  chatId    String
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  role      String
  parts     Json
  createdAt DateTime @default(now())

  @@index([chatId, createdAt])
}

// ---------------------------------------------------------------------------
// Course RAG index.
//
// Postgres is the source of truth for chunk text and metadata, and provides the
// keyword retrieval leg via a tsvector column (added in a follow-up migration,
// since Prisma cannot express a generated column). Qdrant holds only the dense
// vectors. Fusing those two ranked lists with RRF is the hybrid search.
// ---------------------------------------------------------------------------

model CourseLesson {
  id          String @id // stable slug, e.g. "m4-03-dynamic-routes"
  moduleSlug  String
  moduleNum   Int
  moduleLabel String
  /// Title parsed from the folder name; may be a placeholder like "Chapter 2".
  title        String
  /// Title recovered from the transcript, used for display and citations.
  displayTitle String
  kind        String
  order       Int
  courseOrder Int
  /// Who taught the lesson. Distinct from the persona answering the question.
  instructor  String
  durationMs  Int
  cueCount    Int
  /// sha256 of the source .srt — lets re-ingest skip unchanged lessons.
  contentHash String
  /// Null until per-lesson deep links exist; citations render as text for now.
  videoUrl    String?
  summary     String
  topics      String[]
  /// topics joined into plain text. array_to_string is not immutable, so a
  /// generated tsvector column cannot read the array directly — this denormalized
  /// copy is what the search vector indexes.
  topicsText  String  @default("")
  srtPath     String
  updatedAt   DateTime @updatedAt

  /// Generated by Postgres; declared here only so migrate diff does not drop it.
  tsv Unsupported("tsvector")?

  segments CourseSegment[]
  chunks   CourseChunk[]

  @@index([moduleNum, courseOrder])
}

model CourseSegment {
  id       String       @id
  lessonId String
  lesson   CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  ordinal  Int
  title    String
  startCue Int
  endCue   Int
  startMs  Int
  endMs    Int
  /// Full text of the topic block — this is what the answering model reads.
  text     String

  chunks CourseChunk[]

  @@index([lessonId, ordinal])
}

model CourseChunk {
  id        String        @id
  lessonId  String
  lesson    CourseLesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  segmentId String
  segment   CourseSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  ordinal   Int
  startCue  Int
  endCue    Int
  startMs   Int
  endMs     Int
  /// Verbatim transcript for this window — never model-generated.
  text      String
  /// One situating sentence that restores the nouns spoken language omits.
  context   String
  tags      String[]
  /// tags joined into plain text — see CourseLesson.topicsText for why.
  tagsText  String   @default("")

  /// Generated by Postgres; declared here only so migrate diff does not drop it.
  tsv Unsupported("tsvector")?

  @@index([lessonId])
  @@index([segmentId])
}